    border-right-color: var(--fmb-outline);
    border-left-color: var(--fmb-outline);
}

/* The native contract border appears in each desktop layout. */
#ContractLargeBody #Border,
#ContractStandardBody #Border,
#ContractSmallBody #Border {
    border-color: var(--fmb-outline);
}

/* Frame the two sibling panes, including the narrower and international lists. */
#MessagesListSwitch .messages-tool-list-container,
#MessagesListSwitch .messages-tool-list-container-small,
#MessagesToolBlockMessageContent .message-container-frame {
    border-color: var(--fmb-outline);
    border-width: 1px;
}
