/* Shared outline colour. Only Messages adds border width. */
:root {
    --fmb-outline: #3B3B3B;
    --core-controls-border-pc-default: var(--fmb-outline);
    --global-border-color: var(--fmb-outline);
    --layout-dividers-surface: var(--fmb-outline);
    --layout-modules-block-border-colour: var(--fmb-outline);
    --layout-modules-cell-border-color: var(--fmb-outline);
    --layout-modules-tiles-border-color: var(--fmb-outline);
    --layout-modules-tiles-interaction-border-color: var(--fmb-outline);
    --layout-ui-core-controls-border-pc-default: var(--fmb-outline);
    --layout-ui-global-border: var(--fmb-outline);
    --layout-ui-tiles-interaction-border-default: var(--fmb-outline);
    --layout-ui-tiles-light-border: var(--fmb-outline);
    --theme-core-base-border-base-default: var(--fmb-outline);
    --theme-core-base-border-base-disabled: var(--fmb-outline);
    --theme-core-base-border-soft-default: var(--fmb-outline);
    --theme-core-base-border-soft-disabled: var(--fmb-outline);
    --tiles-border-default: var(--fmb-outline);
}

/* Existing neutral outlines with their own colour declarations. */
.border-bottom-color-theme-core-base-border-base-default,
.broadcast-graphics-efl-pre-match-table-row-property-1-base,
.buttons-button-tertiary-default,
.buttons-button-tertiary-default:disabled,
.data-display-data_display-table-heading-default-default,
.data_display-table-heading-default-default,
.date-grid-day-week-overridden #Header,
.disabled-look .buttons-button-tertiary-default,
.fmb-offer060 #ContainerActions,
.fmb-offer060 #top-header-frame,
.fmb-social-group-row,
.fmb058-stat-row,
.global-text-tertiary-underline,
.grid-element__info-header,
.head-head-part-button,
.league-table-top-bottom-six-border .virtualised-list__item--first,
.league-table-top-bottom-six-no-border .virtualised-list__item--first,
.portal-agenda-list-item-default-type-default-last-child-false,
.si-dropdown-iphone .virtualised-list__item,
.vertical_list_item_separator > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item,
.vertical_llist_item_separator > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item {
    border-bottom-color: var(--fmb-outline);
}

.x_y_axis {
    border-bottom-color: var(--fmb-outline);
    border-left-color: var(--fmb-outline);
}

.border-left-color-theme-core-base-border-base-default,
.coach-assignment-workload-container,
.player_position_dropdown .si-dropdown__down-arrow {
    border-left-color: var(--fmb-outline);
}

.border-right-color-theme-core-base-border-base-default,
.date-grid-day-week-overridden-right-margin #Header,
.date-grid-week-text-label {
    border-right-color: var(--fmb-outline);
}

.calendar-training-day-standard-default-type-upcoming,
.calendar-training-weekly-small-default-type-default,
.calendar-training-weekly-standard-default-type-default {
    border-right-color: var(--fmb-outline);
    border-bottom-color: var(--fmb-outline);
}

.tactics-visualiser-player-bottom-border {
    border-right-color: var(--fmb-outline);
    border-bottom-color: var(--fmb-outline);
    border-left-color: var(--fmb-outline);
}

.border-top-color-theme-core-base-border-base-default,
.color-field__input-alpha-container,
.fmb-hierarchy-section-caption,
.list-layout-divider-solid-horizontal,
.match-rules-property-1-expanded,
