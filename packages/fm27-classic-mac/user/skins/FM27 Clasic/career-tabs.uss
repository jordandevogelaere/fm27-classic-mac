/* Each editable grid stays inside its own flex slot when FM restores a choice. */
#FMBPlayerPanelScroll { display: flex; flex-grow: 1; flex-basis: 0; min-height: 0; }
#FMBPlayerPanelBoard { width: 100%; flex-direction: column; padding-bottom: 10px; }
#FMBPlayerPanelBoard > .fmb-slot-row { flex-direction: row; flex-shrink: 0; margin-bottom: 10px; }
#FMBPlayerRow0 { height: 446px; }
#FMBPlayerRow1 { height: 280px; }
#FMBPlayerRow2, #FMBPlayerRow3 { height: 144px; }
#FMBPlayerPanelBoard .fmb-slot-holder { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 0; margin-right: 10px; overflow: hidden; }
#FMBPlayerPanelBoard #FMBPlayerSlot00, #FMBPlayerPanelBoard #FMBPlayerSlot11, #FMBPlayerPanelBoard #FMBPlayerSlot23, #FMBPlayerPanelBoard #FMBPlayerSlot34 { margin-right: 0; }
#FMBPlayerPanelBoard #FMBPlayerSlot11 { flex-grow: 3; }
.fmb085-small #FMBPlayerSlot22, .fmb085-small #FMBPlayerSlot33, .fmb085-small #FMBPlayerSlot34, .fmb085-standard #FMBPlayerSlot34 { display: none; }
.fmb085-small #FMBPlayerPanelBoard #FMBPlayerSlot32, .fmb085-standard #FMBPlayerPanelBoard #FMBPlayerSlot33 { margin-right: 0; }
#FMBPlayerPanelBoard .fmb-independent-grid, #FMBPlayerPanelBoard .grid-content-wrapper, #FMBPlayerPanelBoard FixedAspectGridLayoutElement { width: 100%; height: 100%; min-width: 100%; min-height: 100%; flex-grow: 1; }
#FMBPlayerPanelScroll #FMBPlayerPanelBoard .fmb-independent-grid #GridLayoutElementContent { min-width: 100%; max-width: 100%; min-height: 100%; max-height: 100%; }
#FMBPlayerPanelScroll #FMBPlayerPanelBoard .fmb-independent-grid #GridLayoutElementContent > .grid-element-scope { min-width: 100%; max-width: 100%; min-height: 100%; max-height: 100%; margin: 0; padding: 0; translate: 0 0; }