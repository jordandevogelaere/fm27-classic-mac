    min-width: 0;
    height: 68px;
    min-height: 68px;
    align-self: center;
}
#PlayerReport #report-player-banner-mid > .justify-content-end > #Frame {
    flex-basis: 0;
    min-width: 0;
    align-self: center;
}
#PlayerReport .fmb085-standard #PlayerReportHeaderGradient #PersonPictureFrame {
    width: 100px;
    min-width: 100px;
    max-width: 100px;
    height: 94px;
    min-height: 94px;
    max-height: 94px;
