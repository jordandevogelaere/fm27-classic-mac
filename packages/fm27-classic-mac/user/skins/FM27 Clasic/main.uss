/* The title/search button keeps its click area and existing fill. */
#MainNav #FMB071NavHeading.fmb071-heading {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}
#MainNav #FMB071NavHeading.fmb071-heading:hover {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}
#MainNav #FMB071NavHeading.fmb071-heading:active {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

/* End Home and Club overview woven backdrop. */

/* FM Blog: joined header corner and responsive search. */
#SecondaryNavigationBar .fmb066-tabs-plane > #EntityGradient,
#SecondaryNavigationBar .fmb066-tabs-plane > #FMB065NavigationPattern {
    display: flex;
    position: absolute;
    left: 0;
    top: 30px;
    right: auto;
    bottom: auto;
    margin-top: 0;
    width: 12px;
    min-width: 12px;
    max-width: 12px;
    height: 12px;
    min-height: 12px;
    max-height: 12px;
    opacity: 1;
    overflow: hidden;
}
#SecondaryNavigationBar .fmb066-tabs-plane > #EntityGradient {
    background-color: #38383c;
}
#SecondaryNavigationBar .fmb066-tabs-plane > #EntityGradient .global-nav_secondary-texture-entity-viewer {
    display: none;
}
#SecondaryNavigationBar .fmb066-tabs-plane > #FMB065NavigationPattern {
    background-image: none;
    background-color: #292929;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-color: #45474c;
    border-left-color: #45474c;
    border-top-left-radius: 12px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
#SecondaryNavigationBar .fmb066-tabs-plane > #FMB065NavigationPattern > * {
    display: none;
}

/* The navigation row begins at 364px (232px collapsed) and ends 8px
   before the screen edge. Centre the field's end against the whole screen. */
#MainNav #MainNavigationBar > #FMB071NavHeading.fmb071-heading {
    position: absolute;
    left: 0;
    right: 50%;
    top: 0;
    bottom: auto;
    width: auto;
    max-width: none;
    min-width: 0;
    margin-right: 178px;
    background-color: rgba(247, 248, 250, 0.085);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(244, 246, 250, 0.20);
    border-right-color: rgba(244, 246, 250, 0.20);
    border-top-color: rgba(244, 246, 250, 0.20);
    border-bottom-color: rgba(244, 246, 250, 0.20);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.fmb114-navcollapsed #MainNav #MainNavigationBar > #FMB071NavHeading.fmb071-heading {
    margin-right: 112px;
}
.fmb-foundation-small #MainNav #MainNavigationBar > #FMB071NavHeading.fmb071-heading,
.fmb-foundation-standard #MainNav #MainNavigationBar > #FMB071NavHeading.fmb071-heading {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    margin-right: 0;
    max-width: 100%;
}
#MainNav #MainNavigationBar > #FMB071NavHeading.fmb071-heading:hover {
    background-color: rgba(247, 248, 250, 0.12);
    border-left-color: rgba(244, 246, 250, 0.28);
    border-right-color: rgba(244, 246, 250, 0.28);
    border-top-color: rgba(244, 246, 250, 0.28);
    border-bottom-color: rgba(244, 246, 250, 0.28);
}
#MainNav #MainNavigationBar > #FMB071NavHeading.fmb071-heading:active {
    background-color: rgba(247, 248, 250, 0.15);
}
/* End joined header corner and responsive search. */

