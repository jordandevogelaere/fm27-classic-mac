/* Scouting and coaching notes on the full player profile. */
#PlayerReportHeaderGradient #report-player-full-header-max-body {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}
#PlayerReportHeaderGradient #report-player-full-header-max-body > #PhoneSwitch {
    width: auto;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: center;
}
#PlayerReportHeaderGradient #report-player-full-header-max-body .fmb088-header-identity {
    min-width: 155px;
    margin-right: 8px;
}
#PlayerReportHeaderGradient #report-player-full-header-max-body .fmb088-header-actions {
    margin-right: 6px;
}
#PlayerReportHeaderGradient #report-player-full-header-max-body .fmb088-header-details {
    flex-basis: 64%;
    min-width: 0;
}
#PlayerReportHeaderGradient #report-player-full-header-max-body .fmb088-header-detail {
    width: auto;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}
#PlayerReportHeaderGradient #FMBProfileReportNotes {
    flex-basis: 37%;
    flex-shrink: 1;
    flex-grow: 0;
    min-width: 0;
    height: 88%;
    max-height: 156px;
    min-height: 0;
    margin-left: 8px;
    margin-right: 8px;
    align-self: center;
    overflow: hidden;
}
#FMBProfileReportNotes .fmb-notes-fill,
#FMBProfileReportNotes .fmb-notes-columns {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    align-self: stretch;
}
#FMBProfileReportNotes .fmb-notes-columns {
    flex-direction: row;
    align-items: stretch;
}
#FMBProfileReportNotes .fmb-notes-column {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    align-self: stretch;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.032);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
#FMBProfileReportNotes .fmb-notes-pros { margin-right: 3px; }
#FMBProfileReportNotes .fmb-notes-cons { margin-left: 3px; }
#FMBProfileReportNotes .fmb-notes-heading {
    height: 23px;
    flex-shrink: 0;
    padding-left: 6px;
}
#FMBProfileReportNotes .fmb-notes-icon {
    width: 13px;
    height: 13px;
    margin-right: 5px;
}
#FMBProfileReportNotes .fmb-notes-pros .fmb-notes-heading { background-color: rgba(72, 175, 98, 0.13); }
#FMBProfileReportNotes .fmb-notes-cons .fmb-notes-heading { background-color: rgba(208, 93, 89, 0.12); }
#FMBProfileReportNotes .fmb-notes-pros .fmb-notes-caption { color: #a2dab0; }
#FMBProfileReportNotes .fmb-notes-cons .fmb-notes-caption { color: #ebb2ae; }
#FMBProfileReportNotes .fmb-notes-pros .fmb-notes-icon { -unity-background-image-tint-color: #a2dab0; }
#FMBProfileReportNotes .fmb-notes-cons .fmb-notes-icon { -unity-background-image-tint-color: #ebb2ae; }
#FMBProfileReportNotes .fmb-notes-list {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    align-self: stretch;
}
#FMBProfileReportNotes .fmb-notes-list #DescriptionLabel {
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}
#FMBProfileReportNotes .fmb-notes-empty {
    justify-content: center;
    flex-grow: 1;
    align-self: center;
}
/* The native small breakpoint has a compact identity row. Put the notes under
   it so the report columns share the full width beside the portrait. */
#PlayerReportHeaderGradient.report-player-full-header-min-type-player #report-player-full-header-max.fmb069-id-row,
.report-player-full-header-min-type-player #PlayerReportHeaderGradient #report-player-full-header-max.fmb069-id-row,
#PlayerReportHeaderGradient .report-player-full-header-min-type-player #report-player-full-header-max.fmb069-id-row,
#PlayerReportHeaderGradient #report-player-full-header-max.fmb069-id-row.report-player-full-header-min-type-player {
    height: 174px;
    min-height: 174px;
    max-height: 174px;
}
#PlayerReportHeaderGradient.report-player-full-header-min-type-player #report-player-full-header-max-body,
.report-player-full-header-min-type-player #PlayerReportHeaderGradient #report-player-full-header-max-body,
#PlayerReportHeaderGradient .report-player-full-header-min-type-player #report-player-full-header-max-body,
#PlayerReportHeaderGradient #report-player-full-header-max-body.report-player-full-header-min-type-player {
    flex-direction: column;
    align-items: stretch;
}
#PlayerReportHeaderGradient.report-player-full-header-min-type-player #report-player-full-header-max-body > #PhoneSwitch,
.report-player-full-header-min-type-player #PlayerReportHeaderGradient #report-player-full-header-max-body > #PhoneSwitch,
#PlayerReportHeaderGradient .report-player-full-header-min-type-player #report-player-full-header-max-body > #PhoneSwitch {
    width: 100%;
    min-height: 48px;
    align-self: stretch;
}
#PlayerReportHeaderGradient.report-player-full-header-min-type-player #FMBProfileReportNotes,
.report-player-full-header-min-type-player #PlayerReportHeaderGradient #FMBProfileReportNotes,
#PlayerReportHeaderGradient .report-player-full-header-min-type-player #FMBProfileReportNotes {
    width: auto;
    height: 78px;
    min-height: 78px;
    max-height: 78px;
    flex-basis: auto;
    flex-grow: 0;
    align-self: stretch;
    margin-left: 2px;
    margin-bottom: 3px;
}
/* End full player profile notes. */
