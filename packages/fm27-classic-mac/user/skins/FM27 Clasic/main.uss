@import url("custom.uss");
@import url("home.uss");
@import url("my-contract.uss");
@import url("career-tabs.uss");
@import url("borders.uss");
@import url("squad-depth.uss");
@import url("competitions-hub.uss");
@import url("dynamics-tactics.uss");
@import url("news-medical.uss");
@import url("schedule.uss");

@import url("club-pages.uss");

/* Offset the sidebar navigation by one link row. */
#FMBClassicSidebar #FMBClassicLinks #FMB070NavOrder {
    margin-top: 38px;
}

.fmb-foundation-standard #FMBClassicSidebar #FMBClassicLinks #FMB070NavOrder {
    margin-top: 32px;
}
.fmb-foundation-small #FMBClassicSidebar #FMBClassicLinks #FMB070NavOrder,
.fmb114-small #FMBClassicSidebar #FMBClassicLinks #FMB070NavOrder {
    margin-top: 28px;
}

/* Align the brand with the arrows. Paint their background on the same header. */
#FMBClassicSidebar #FMB122SidebarHeader {
    position: relative;
    top: 2px;
}
#MainNav #FMB066SidebarPlate.fmb066-sidebar-plate {
    background-color: transparent;
    background-image: url("textures/fmb-sidebar-seam-wide.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-size: 100% 100%;
    background-repeat: no-repeat;
}
.fmb114-navcollapsed #MainNav #FMB066SidebarPlate.fmb066-sidebar-plate {
    background-image: url("textures/fmb-sidebar-seam-compact.png");
}
#MainNav #FMBGraphiteArtwork.fmb-career-wallpaper-hidden {
    display: none;
}
#MainNav #FMB066SidebarPlate > #FMBViewedClubSidebarFade {
    scale: 1 1;
    top: 95px;
    bottom: 0;
    height: auto;
    background-color: #252528;
}
#MainNav #FMBViewedClubSidebarFade > * {
    height: 355px;
    opacity: 0.903;
}

/* Player overview: protect the Info header and size each fact to its text. */
#PlayerAttributesBlock #InfoBlockHeaderFrame,
#PlayerAttributesBlock #InfoHeaderTextFrame,
#PlayerAttributesBlock #InfoHeaderFrame {
    min-height: 32px;
    flex-shrink: 0;
    align-items: center;
}
#PlayerAttributesBlock #InfoBlockFrame #InfoTitleText {
    align-self: center;
}
#PlayerAttributesBlock #InfoBlockFrame > #Frame,
#PlayerAttributesBlock #InfoBlockFrame #PersonalityVisibleForActualPlayer {
    flex-shrink: 0;
    align-self: stretch;
}
#PlayerAttributesBlock #InfoBlockFrame #PersonHeightTextFrame,
#PlayerAttributesBlock #InfoBlockFrame #PlayerReputationTextFrame,
#PlayerAttributesBlock #InfoBlockFrame #PlayerPersonalityTitleTextFrame {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    min-height: 22px;
    flex-shrink: 0;
    margin: 0;
}
#PlayerAttributesBlock #InfoBlockFrame #PersonHeightTitleText,
#PlayerAttributesBlock #InfoBlockFrame #PlayerReputationTitleText,
#PlayerAttributesBlock #InfoBlockFrame #PlayerPersonalityTitleText {
    margin-bottom: 0;
    margin-right: 6px;
}
#PlayerAttributesBlock #InfoBlockFrame #PlayerTraitsFrameList,
#PlayerAttributesBlock #InfoBlockFrame #PlayerReportBansBlock {
    margin-top: 0;
}
#PlayerAttributesBlock #InfoBlockFrame > .margin-vertical-global-gap-regular {
    margin-top: 3px;
    margin-bottom: 3px;
}
#PlayerAttributesBlock .fmb055-radar#AttributeSpiderChart {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 0;
    align-items: center;
    justify-content: center;
}

/* Crop only the outermost top edge of the transparent portrait layer. */
#report-player-full-header-max #PersonPictureFrame #PictureTeamRemapper,
#report-non-player-full-header-max-type-player #PersonPictureFrame #PictureTeamRemapper {
    top: 2px;
    bottom: 0;
    height: auto;
    min-height: 0;
    max-height: none;
    overflow: hidden;
}
#PersonPictureFrame #PictureTeamRemapper > #PersonPicture {
    position: absolute;
    right: 0;
    bottom: 0;
}

/* Keep the stadium and its painted sectors inside the inbox attachment. */
#MessageAttachments #spread-container > #chart-container.fmb069-bowl {
    width: 160px;
    min-width: 160px;
    max-width: 160px;
    height: 184px;
    min-height: 184px;
    max-height: 184px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 28px;
}
#MessageAttachments #chart-container.fmb069-bowl .fmb069-sector-disc {
    width: 264px;
    min-width: 264px;
    max-width: 264px;
    height: 264px;
    min-height: 264px;
    max-height: 264px;
    left: -52px;
    top: -40px;
}

/* Match the club-report header when showing the manager's own team. */
#MainNav #FMBHeaderQuickFlicks > #BaseLayer {
    flex-direction: row-reverse;
}

#CardBody, #ReportBody, #PlayerInstructionsCard, #PlayerReport {
    overflow: visible;
}
.fmb132-state { display: none; }
#FMB132PitchPlayerName {
    align-self: stretch;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}
#PlayerReport #FMB132PlayerViewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    align-self: stretch;
}
#ReportBody #PlayerReport .fmb132-pitch-profile {
    overflow: visible;
}
#ReportBody #PlayerReport .fmb132-pitch-profile > #FMB132PlayerViewport {
    position: absolute;
    left: -198px;
    top: -10px;
    right: -10px;
    bottom: -10px;
    padding: 10px;
    background-color: #292929;
}
#CardBody #PlayerInstructionsCard .fmb071-shirt-card {
    overflow: visible;
}
#CardBody #PlayerInstructionsCard #FMB132InstructionsViewport {
    position: absolute;
    left: -198px;
    top: -110px;
    right: -10px;
    bottom: -10px;
    margin: 0;
    padding: 0;
    align-items: stretch;
    justify-content: center;
    background-color: rgba(12, 13, 16, 0.70);
}
#CardBody #PlayerInstructionsCard #FMB132InstructionsViewport > #OptionalsDefaulter {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
}
#CardBody #PlayerInstructionsCard #CardController {
    align-items: center;
    justify-content: center;
    background-color: transparent;
}
#CardBody #PlayerInstructionsCard #CardContainer {
    position: relative;
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    flex-basis: auto;
    align-self: stretch;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    background-color: transparent;
    background-image: none;
}
#ReportBody #PlayerReport .fmb132-pitch-profile.fmb114-collapsed > #FMB132PlayerViewport {
    left: -66px;
}
#CardBody #PlayerInstructionsCard #CardContent {
    width: 1618px;
    max-width: 96%;
    min-width: 0;
    height: 890px;
    max-height: 94%;
    min-height: 0;
    padding: 8px;
    border-width: 1px;
    border-color: #484848;
    border-radius: 4px;
    align-self: center;
    align-items: stretch;
    justify-content: center;
}
#CardBody #PlayerInstructionsCard #SpeakToVariables {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    min-width: 0;
    min-height: 0;
    flex-basis: auto;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}
#CardBody #PlayerInstructionsCard .fmb067-popup-shade {
    display: none;
}



#FMB132PitchPlayerName > #FMB132PitchClick {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* Continue the primary club artwork behind the navigation links and bookmarks. */
#MainNav #FMBFlushHeader {
    min-height: 95px;
}
#SecondaryNavigationBar #FMBFlushHeader,
#SecondaryNavigationBar #EntityGradient,
#SecondaryNavigationBar #FMB065NavigationPattern {
    display: none;
}
#SecondaryNavigationBar,
#SecondaryNavigationBar .fmb066-tabs-plane,
#SecondaryNavigationBar .fmb065-nav-safe,
#SecondaryNavigationBar #FMBViewedEntityTabs,
#SecondaryNavigationBar #Bookmarks {
    background-color: transparent;
}

/* The dynamic class on the wrapper supplies a morale level. Only the image in
   the row should paint the glyph; the wrapper needs room for the description. */
#FMBMoraleCell.fmb-happiness-cell051 {
    background-image: none;
    width: 100%;
    height: auto;
    align-self: stretch;
    justify-content: center;
}
#FMBMoraleCell > #Morale.fmb-happiness-cell-content051 {
    background-image: none;
}
#FMBMoraleCell > #Morale > .siimage {
    width: 16px;
    min-width: 16px;
    max-width: 16px;
    height: 16px;
    min-height: 16px;
    max-height: 16px;
    flex-shrink: 0;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
}

/* Extend the rotated sidebar strokes past the join with the navigation artwork. */
#MainNav #FMB066SidebarPlate > VisualElement {
    scale: 1 1.12;
}

/* These five hairlines share the header canvas. Anchor them to its right edge,
   so the spacing follows the window and the bookmark row at every resolution. */
#MainNav #FMBFlushHeader > #FMBHeaderContinuation0,
#MainNav #FMBFlushHeader > #FMBHeaderContinuation1,
#MainNav #FMBFlushHeader > #FMBHeaderContinuation2,
#MainNav #FMBFlushHeader > #FMBHeaderContinuation13,
#MainNav #FMBFlushHeader > #FMBHeaderContinuation14 {
    margin-left: 100%;
}
#MainNav #FMBFlushHeader > #FMBHeaderContinuation1 { translate: -395.06px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation2 { translate: -394.56px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation0 { translate: -211.46px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation13 { translate: -566.6px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation14 { translate: -568.6px 0; }

/* Leave the clickable sidebar's geometry intact; start its divider below both rows. */
#MainNav #FMBClassicSidebar { border-right-color: transparent; }
#MainNav #FMBHeaderSurface049.fmb068-nav-surface {
    left: 188px;
    right: auto;
    top: 95px;
    bottom: auto;
    width: 1px;
    height: 3200px;
    background-color: #45474c;
}
.fmb114-navcollapsed #MainNav #FMBHeaderSurface049.fmb068-nav-surface { left: 56px; }
#MainNav #FMBHeaderSurface049 > * { display: none; }

/* At the narrower join the header samples a stronger part of the same gradient. */
.fmb114-navcollapsed #MainNav #FMBFlushHeader > #FMBRefEdgeLeft { opacity: 0.80; }

/* The narrow spill uses the same viewed-entity gradient as the header itself. */
#SecondaryNavigationBar #FMBFlushHeader {
    display: flex;
    margin-top: 30px;
    max-width: 8px;
    min-height: 3200px;
    opacity: 0.16;
}
#SecondaryNavigationBar #FMBFlushExpanded { margin-left: 188px; }
#SecondaryNavigationBar #FMBFlushCompact { margin-left: 56px; }
#SecondaryNavigationBar #FMBFlushHeader #FMBRefEdgeLeft { min-width: 100%; }
#SecondaryNavigationBar #FMBFlushHeader #FMBRefEdgeRight,
#SecondaryNavigationBar #FMBFlushExpanded > VisualElement,
#SecondaryNavigationBar #FMBFlushCompact > VisualElement { display: none; }

/* Keep the whole right-hand motif inside the last tenth of the header. */
#MainNav #FMBFlushHeader > #FMBHeaderContinuation1 { margin-left: 90.8%; translate: 22.94px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation2 { margin-left: 90.8%; translate: 23.44px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation0 { margin-left: 95.5%; translate: 39.54px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation13 { margin-left: 100%; translate: -492.6px 0; }
#MainNav #FMBFlushHeader > #FMBHeaderContinuation14 { margin-left: 100%; translate: -494.6px 0; }

/* Round the inside junction where the content meets both navigation bars. */
.fmb114-navstate #MainNav #FMBContextHeaderColour.fmb-context-header-colour {
    left: 188px;
    right: auto;
    top: 95px;
    bottom: auto;
    width: 12px;
    height: 12px;
    overflow: hidden;
    background-color: #252528;
    opacity: 0.70;
}
.fmb114-navcollapsed #MainNav #FMBContextHeaderColour.fmb-context-header-colour {
    left: 56px;
    opacity: 0.68;
}
#MainNav #FMBHeaderSurface049.fmb068-nav-surface {
    width: auto;
    right: 0;
    background-color: transparent;
    border-left-width: 1px;
    border-left-color: #45474c;
    border-top-width: 1px;
    border-top-color: #45474c;
    border-top-left-radius: 12px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    overflow: hidden;
}
#MainNav #FMBHeaderSurface049 > #FMB065NavigationPattern {
    display: flex;
    position: absolute;
    left: 0;
    top: 0;
    right: auto;
    width: 11px;
    max-width: 11px;
    bottom: auto;
    height: 12px;
    background-color: #292929;
}
#MainNav #FMBHeaderSurface049 > #FMB065NavigationPattern > * { display: none; }
#SecondaryNavigationBar #FMBFlushHeader { margin-top: 42px; }

/* The preview grid has ten columns of player information and five of report.
   Extend only its non-interactive artwork across their shared row. */
.sitooltip.fmb-player-preview {
    background-color: #242528;
    border-radius: 10px;
    border-width: 1px;
    border-color: #47494e;
    overflow: hidden;
}
.fmb-player-preview #PlayerReportHeaderTooltip,
.fmb-player-preview #PlayerReportHeaderTooltip > BindingRemapper,
.fmb-player-preview #PlayerReportHeaderTooltip .grid-element--Block,
.fmb-player-preview #PlayerReportHeaderTooltip .grid-element--Block > TemplateContainer,
.fmb-player-preview #PlayerReportHeaderTooltip .fmb085-popup-header,
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-header-remap,
.fmb-player-preview #PlayerReportHeaderTooltip .fmb071-preview-banner {
    overflow: visible;
    background-color: transparent;
}
.fmb-player-preview #PlayerReportHeaderTooltip #FMB067ReportPlate {
    left: 0;
    right: -50%;
    width: auto;
    margin-right: -5px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #252528;
}
.fmb-player-preview #FMB067ReportPlate .fmb066-profile-colour {
    right: auto;
    width: 70%;
    opacity: 0.90;
}
.fmb-player-preview #FMB067ReportPlate .fmb066-profile-edge {
    display: flex;
    left: auto;
    right: 0;
    top: 0;
    bottom: 0;
    width: 28%;
    height: 100%;
    scale: -1 1;
    opacity: 0.36;
}
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line0,
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line1,
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line2,
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line3,
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line4,
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line5 {
    display: flex;
    position: absolute;
    width: 1px;
    height: 270px;
    top: 50%;
    margin-top: -135px;
    rotate: 35deg;
    background-color: rgba(229, 232, 236, 0.13);
}
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line0 { left: 3%; right: auto; }
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line1 { left: 4%; right: auto; opacity: 0.55; }
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line2 { left: auto; right: 13%; }
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line3 { left: auto; right: 12%; opacity: 0.55; }
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line4 { left: auto; right: 4%; }
.fmb-player-preview #FMB067ReportPlate > .fmb066-profile-line5 { left: auto; right: 3%; opacity: 0.55; }

.fmb-player-preview #CoachScoutReportBlock,
.fmb-player-preview #CoachScoutReportBlock .grid-element--Block,
.fmb-player-preview #CoachScoutReportBlock .fmb050-preview-coach,
.fmb-player-preview #CoachScoutReportBlock #CoachBlock,
.fmb-player-preview #CoachScoutReportBlock #ScoutBlock {
    background-color: transparent;
    border-width: 0;
}
.fmb-player-preview #CoachScoutReportBlock .fmb050-summary-inset {
    border-left-width: 1px;
    border-left-color: rgba(229, 232, 236, 0.15);
    padding-left: 10px;
    min-width: 0;
}
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-name {
    font-size: 18px;
    -unity-font-style: bold;
}
.fmb-player-preview #CoachScoutReportBlock .fmb050-summary-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f1f1ed;
}

/* The identity and the club rows share the same text inset, including when
   there is no visible editor icon before the name. */
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-identity-inner,
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-contract > .fmb-preview-clubs {
    padding-left: 8px;
}
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-identity-inner > .column-direction-normal.margin-right-global-gap-regular {
    margin-right: 0;
}
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-clubs {
    justify-content: flex-start;
}
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-clubs #ClubIcon {
    margin-left: 0;
    margin-right: 4px;
    align-items: flex-start;
}
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-person .nation-flag-small-16px {
    align-items: flex-start;
}
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-person #NationFlag {
    width: 100%;
}
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-clubs #PlayingTime .sitext,
.fmb-player-preview #PlayerReportHeaderTooltip .fmb-preview-value .secondary-text-colour {
    color: #c8cbd2;
}

.fmb-player-preview #PlayerAttributesBlock {
    border-radius: 7px;
    border-width: 1px;
    border-color: #404145;
    overflow: hidden;
}


/* FM Blog: Home and Club overview woven backdrop. */

/* Club overview artwork uses the same weave at both ends of the header seam. */

.fmb067-club-hero,
#HomeClubContext .fmb067-club-hero,
#ClubSite .fmb067-club-hero {
    background-image: url("textures/fmb-fine-overview-header-76c8ac78ca.png");
    -unity-background-image-tint-color: #ffffff;
    -unity-background-scale-mode: stretch-to-fill;
}

.fmb125-home-main,
#ClubHomeLargeBody .fmb125-home-main,
#HomeClubContext #ClubHomeLargeBody .fmb125-home-main,
#ClubSite #ClubHomeLargeBody .fmb125-home-main,
#ClubSiteBlock .fmb125-home-main,
#ClubSiteBlockMidRes > .siblock-border,
#ClubSiteBlockLowRes > .siblock-border,
#ClubSiteBlockMidRes.siblock-border,
#ClubSiteBlockLowRes.siblock-border {
    background-image: url("textures/fmb-fine-overview-body-c67667bcdc.png");
    -unity-background-image-tint-color: #ffffff;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Career blocks are separate from the compact tile elements. */

#MenuBody .grid-element--Block,
#ReportBody .grid-element--Block {
    background-image: url("textures/fmb-fine-panel-346914a4f0.png");
    -unity-background-image-tint-color: #ffffff;
    background-size: 600px 600px;
    background-repeat: repeat;
}

#MenuBody .grid-element--Block > TemplateContainer > .block-border-only,
#MenuBody .grid-element--Block > TemplateContainer > .frames-general-view,
#MenuBody .grid-element--Block > TemplateContainer > .layout-block-base-container,
#MenuBody .grid-element--Block > TemplateContainer > .siblock,
#MenuBody .grid-element--Block > TemplateContainer > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > .block-border-only,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > .frames-finance-graph-property,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > .frames-world-knowledge-property-1-nations,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > .layout-block-base-container,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > .siblock,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > BindableSwitchElement > BindingVariables > BindingRemapper > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > BindableSwitchElement > BindingVariables > ComponentElement > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > BindableSwitchElement > ComponentElement > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > BindingRemapper > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > BindingRemapper > BindableSwitchElement > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > BindingVariables > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > BindingVariables > BindingRemapper > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > ComponentElement > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > ComponentElement > BindableSwitchElement > VisualElement > .block-border-only,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > SIVisible > ComponentElement > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > SIVisible > VisualElement > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > VisualElement > .block-border-only,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > VisualElement > .siblock-border {
    background-color: transparent;
}

#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > VisualElement > BindableSwitchElement > .block-border-only,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > VisualElement > SIStyleSetter > .frames-summary-property-1-board,
#MenuBody .grid-element--Block > TemplateContainer > BindingExpect > VisualElement > SIVisible > VisualElement > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > BindingVariables > .layout-block-base-container,
#MenuBody .grid-element--Block > TemplateContainer > BindingVariables > .siblock-border,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .block-border-only,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .fmb070-profile-line,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .frame-panel-squad,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .frames-general-view,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .frames-income-breakdown,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .frames-national-team-overview-property-1-standard,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .frames-player-attributes-full-block-size-max-rows,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .frames-player-attributes-full-block-size-min-player-attributes-property-3-compact,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .frames-staff_attributes-full_frame-standard-states-manager,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .layout-block-base-container,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .siblock,
#MenuBody .grid-element--Block > TemplateContainer > ComponentElement > .siblock-border,
